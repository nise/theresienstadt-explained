  keywords   = {Erinnerungskuktur, Geschichte (Ghetto), Theresienstadt (Ghetto)},
  pages      = {175--194},
  file       = {Full Text PDF:files/223/Prager - 2008 - Interpreting the Visible Traces of Theresienstadt.pdf:application/pdf;Snapshot:files/224/14725880802124206.html:text/html}
