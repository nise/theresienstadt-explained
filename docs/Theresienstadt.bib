@book{piechocki_alice_2011,
  address    = {München},
  title      = {Alice {Herz}-{Sommer} "{Ein} {Garten} {Eden} inmitten der {Hölle}": ein {Jahrhundertleben}},
  isbn       = {978-3-426-78515-7},
  shorttitle = {Piechocki \& {Müller} 2011},
  abstract   = {A biography of the Czech-Jewish pianist Alice Herz-Sommer, born in Prague in 1903. Describes the German occupation of Prague in 1939 and the first Nazi anti-Jewish measures. In 1942, Alice's mother Sophie Herz was deported and later killed in Treblinka. In July 1943 Alice and her husband, Leopold Sommer, were deported to Theresienstadt. Describes musical life in the ghetto, to which Alice and her son Stephan (1937-2001) contributed. Stephan took part in the performance of Hans Krása's opera "Brundibár". Throughout her internment in Theresienstadt, Alice gave piano recitals, the last of which took place in April 1945. It was because of her musical talent that the SS did not include Alice and her son on the deportation lists in September-October 1944, when the mass deportations of Theresienstadt's prisoners to various camps resumed. However, her husband was deported in September 1944 and died from typhus in Dachau. After the war, Alice and her son emigrated to the State of Israel, where her son changed his name Stephan to Raphael. Eventually both of them settled in London; Raphael Sommer became a cello virtuoso.},
  language   = {de-DE},
  publisher  = {Knaur Taschenbuch},
  author     = {Piechocki, Reinhard and Müller, Melissa},
  year       = {2011},
