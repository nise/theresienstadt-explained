@article{margry_first_1999,
  title      = {The {First} {Theresienstadt} {Film} (1942)},
  volume     = {19},
  issn       = {0143-9685},
  shorttitle = {Margry 1999},
  doi        = {10.1080/014396899100190},
  abstract   = {Examines the very first film produced by Nazis and made by a team of Jewish prisoners in 1942 at Theresienstadt, the Jewish concentration camp in Czechoslovakia. Informs that historiography has paid scant attention to this first film, noting that it has been only recently that sources have emerged to shed some light on it. Mentions that these sources include an original draft script and several still pictures, but by far the most spectacular new source is some eight minutes of film footage, which surfaced at the Polish Wytwórnia Filmow Dokumentalnych i Fabularnych (WFDiF) film archive in Warsaw in 1994, which shows the camera crew at work during the shooting of the film and also contains several scenes from the film itself. States that the purpose of this article is to outline the history of the 1942 film, and second, to describe and analyze the new-found sources and footage.},
