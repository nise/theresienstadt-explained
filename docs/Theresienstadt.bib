@article{klein_theresienstadt_2005,
  title      = {Theresienstadt: {Ghetto} oder {Konzentrationslager}?},
  shorttitle = {Klein 2005},
  url        = {https://www.ceeol.com/search/article-detail?id=247474},
  abstract   = {m Mittelpunkt des Beitrags steht die Frage, ob die unterschiedliche Qualifizierung Theresienstadts als Ghetto oder Konzentrationslager in der wissenschaftlichen Literatur sinnvoll ist. In dem Beitrag wird der Beweis geführt, dass Heydrich und die Sicherheitspolizei im Falle Theresienstadts stets in den konzeptionellen Kategorien eines Ghettos dachten und ihre Erfahrungen mit den Ghettos in Lodz, Vilnius und Kaunas in die Planung zur Verwaltung des Ghettos Theresienstadt einfließen ließen. Tatsächlich war Theresienstadt nie als Konzentrationslager geplant und wurde auch später nicht in ein solches umgewandelt.},
